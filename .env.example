# LLM API Keys
# Copy this file to .env and fill in your actual API keys
# NEVER commit the .env file to version control

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-organization-id

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google AI API
GOOGLE_API_KEY=your-google-ai-api-key-here

# Database Configuration (if using remote database)
DATABASE_URL=postgresql://username:password@localhost:5432/proteomics_db

# Logging Level
LOG_LEVEL=INFO

# Project Configuration
PROJECT_ROOT=/path/to/project
DATA_DIR=/path/to/data

# API Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_TOKENS_PER_REQUEST=4000

# Experiment Configuration
RANDOM_SEED=42
TEST_SIZE=0.2

# Cache Configuration
ENABLE_CACHE=true
CACHE_DIR=.cache

# Protein Database APIs (if authentication required)
UNIPROT_API_KEY=your-uniprot-key-if-needed
PDB_API_KEY=your-pdb-key-if-needed

# Email notifications (for long-running experiments)
NOTIFICATION_EMAIL=your-email@example.com

# Development vs Production
ENVIRONMENT=development
