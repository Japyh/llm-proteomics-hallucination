/*
 * Nextflow configuration for LLM Proteomics Hallucination Study
 */

// Manifest
manifest {
    name = 'llm-proteomics-hallucination'
    author = 'Olaf Yunus Laitinen Imanov'
    homePage = 'https://github.com/olaflaitinen/llm-proteomics-hallucination'
    description = 'Evaluation of hallucinations in LLM responses to proteomics queries'
    mainScript = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version = '1.0.0'
}

// Global default parameters
params {
    // Input/Output
    queries = 'data/queries/queries_all.json'
    output_dir = 'data/results'

    // LLM models
    models = ['gpt4_turbo', 'claude_sonnet', 'gemini_pro']

    // Evaluation parameters
    test_size = 0.2
    random_seed = 42
    n_bootstrap = 1000
    confidence_level = 0.95

    // API rate limits
    rate_limit_rpm = 60
    rate_limit_tpm = 90000

    // Resource allocation
    max_cpus = 8
    max_memory = '32.GB'
    max_time = '48.h'

    // Reporting
    enable_conda = false
    enable_docker = true
    singularity_pull_docker_container = false
}

// Executor configuration
executor {
    name = 'local'
    cpus = params.max_cpus
    memory = params.max_memory
    queueSize = 10
}

// Process configuration
process {
    // Default resources
    cpus = 2
    memory = '4.GB'
    time = '2.h'

    // Error handling
    errorStrategy = 'retry'
    maxRetries = 3

    // Resource labels
    withLabel: 'low_compute' {
        cpus = 1
        memory = '2.GB'
        time = '1.h'
    }

    withLabel: 'medium_compute' {
        cpus = 4
        memory = '8.GB'
        time = '4.h'
    }

    withLabel: 'high_compute' {
        cpus = 8
        memory = '16.GB'
        time = '8.h'
    }

    withLabel: 'api_call' {
        maxForks = 1  // Limit concurrent API calls
        time = '30.m'
    }
}

// Container configuration
docker {
    enabled = params.enable_docker
    temp = 'auto'
    runOptions = '-u $(id -u):$(id -g)'
}

singularity {
    enabled = !params.enable_docker
    autoMounts = true
    cacheDir = 'work/singularity'
}

// Conda configuration
conda {
    enabled = params.enable_conda
    cacheDir = 'work/conda'
}

// Reporting
report {
    enabled = true
    file = "${params.output_dir}/execution_report.html"
}

timeline {
    enabled = true
    file = "${params.output_dir}/execution_timeline.html"
}

trace {
    enabled = true
    file = "${params.output_dir}/execution_trace.txt"
}

dag {
    enabled = true
    file = "${params.output_dir}/pipeline_dag.svg"
}

// Profiles
profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled = true
        process.container = 'llm-proteomics:1.0.0'
    }

    singularity {
        singularity.enabled = true
        process.container = 'llm-proteomics_1.0.0.sif'
    }

    hpc {
        process.executor = 'slurm'
        process.queue = 'normal'
        process.clusterOptions = '--account=proteomics'
    }

    test {
        params.models = ['gpt4_turbo']
        params.n_bootstrap = 100
    }
}
