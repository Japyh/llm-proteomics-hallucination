# Snakemake workflow for LLM evaluation

configfile: "configs/default.yaml"

rule all:
    input:
        "results/hallucination_rates.csv",
        "results/model_comparison.csv",
        "paper/figures/output/fig1_hallucination_rate_vs_complexity.png"

rule run_llm_eval:
    input:
        queries="data/queries/queries_all.json"
    output:
        "data/llm_responses/{model}_responses.jsonl"
    shell:
        "python src/llm_eval/runner.py --model {wildcards.model} --input {input.queries} --output {output}"

rule analyze_results:
    input:
        expand("data/llm_responses/{model}_responses.jsonl", model=["gpt4", "claude", "gemini"])
    output:
        "results/hallucination_rates.csv"
    shell:
        "python src/analysis/stats_models.py --input {input} --output {output}"

rule generate_figures:
    input:
        "results/hallucination_rates.csv"
    output:
        "paper/figures/output/fig1_hallucination_rate_vs_complexity.png"
    shell:
        "python paper/figures/generate_figure_1.py"
