# Docker ignore file - exclude from Docker build context

# Git
.git/
.gitignore
.gitattributes

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Test and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Documentation build
docs/_build/
site/

# LaTeX temp files
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk

# Data files (too large, privacy)
data/raw/
data/processed/
*.csv
*.json
*.parquet
*.h5
*.hdf5

# Results (generated, not needed in image)
results/figures/*.pdf
results/figures/*.png
results/tables/
results/logs/
paper/figures/output/

# Environment files
.env
.env.local
*.key
credentials.json

# OS files
Thumbs.db
.DS_Store

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# GitHub
.github/

# README and docs (not needed in build)
*.md
!requirements.txt
!requirements-dev.txt
