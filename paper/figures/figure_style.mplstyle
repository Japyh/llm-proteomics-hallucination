# Matplotlib style for publication figures

# Figure size
figure.figsize: 8, 6
figure.dpi: 300
savefig.dpi: 300

# Font
font.family: sans-serif
font.sans-serif: Arial, Helvetica
font.size: 10

# Axes
axes.labelsize: 11
axes.titlesize: 12
axes.linewidth: 1.5
axes.grid: True
grid.alpha: 0.3

# Lines
lines.linewidth: 2
lines.markersize: 8

# Legend
legend.fontsize: 9
legend.frameon: True

# Colors (colorblind-friendly)
axes.prop_cycle: cycler('color', ['4472C4', '70AD47', 'FFC000', 'C65911', '7030A0'])
