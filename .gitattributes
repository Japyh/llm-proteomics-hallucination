# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf
*.pyx text eol=lf
*.ipynb text eol=lf

# Shell scripts
*.sh text eol=lf

# Documentation
*.md text eol=lf
*.rst text eol=lf

# Data files
*.csv text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.tiff binary
*.h5 binary
*.hdf5 binary
