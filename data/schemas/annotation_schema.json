{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Annotation Schema",
  "type": "object",
  "required": ["query_id", "response_id", "has_hallucination", "annotator_id"],
  "properties": {
    "query_id": {"type": "string"},
    "response_id": {"type": "string"},
    "has_hallucination": {"type": "boolean"},
    "severity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "annotator_id": {"type": "string"},
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
