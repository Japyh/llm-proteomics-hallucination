{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/olaflaitinen/llm-proteomics-hallucination/schemas/ontology.json",
  "title": "Proteomics Ontology Schema",
  "description": "Schema for ontology terms and mappings in proteomics hallucination study",
  "type": "object",
  "required": ["ontology_id", "term", "definition", "category"],
  "properties": {
    "ontology_id": {
      "type": "string",
      "description": "Unique ontology identifier (e.g., GO:0008150, UniProt:P04637)",
      "pattern": "^[A-Z]+:[A-Z0-9]+$"
    },
    "term": {
      "type": "string",
      "description": "Ontology term label",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "description": "Detailed definition of the term"
    },
    "category": {
      "type": "string",
      "enum": [
        "biological_process",
        "molecular_function",
        "cellular_component",
        "disease",
        "protein",
        "modification",
        "interaction"
      ],
      "description": "Ontology category"
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alternative names for the term"
    },
    "parent_terms": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+:[A-Z0-9]+$"
      },
      "description": "Parent ontology terms"
    },
    "child_terms": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+:[A-Z0-9]+$"
      },
      "description": "Child ontology terms"
    },
    "cross_references": {
      "type": "object",
      "properties": {
        "uniprot": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[OPQ][0-9][A-Z0-9]{3}[0-9]|[A-NR-Z][0-9]([A-Z][A-Z0-9]{2}[0-9]){1,2}$"
          }
        },
        "pubmed": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d+$"
          }
        },
        "go": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^GO:\\d{7}$"
          }
        }
      }
    },
    "evidence_code": {
      "type": "string",
      "enum": [
        "EXP",
        "IDA",
        "IPI",
        "IMP",
        "IGI",
        "IEP",
        "HTP",
        "HDA",
        "HMP",
        "HGI",
        "HEP",
        "IBA",
        "IBD",
        "IKR",
        "IRD",
        "ISS",
        "ISO",
        "ISA",
        "ISM",
        "IGC",
        "RCA",
        "TAS",
        "NAS",
        "IC",
        "ND",
        "IEA"
      ],
      "description": "Evidence code for ontology assignment"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_date": {
          "type": "string",
          "format": "date"
        },
        "updated_date": {
          "type": "string",
          "format": "date"
        },
        "curator": {
          "type": "string"
        }
      }
    }
  }
}
