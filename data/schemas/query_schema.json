{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Query Schema",
  "type": "object",
  "required": ["query_id", "query_text", "domain", "complexity", "protein_prevalence"],
  "properties": {
    "query_id": {
      "type": "string",
      "pattern": "^Q[0-9]{3}$"
    },
    "query_text": {
      "type": "string",
      "minLength": 10
    },
    "domain": {
      "type": "string",
      "enum": ["protein_identification", "quantitative_expression", "post_translational_modifications", "protein_interactions", "clinical_interpretation"]
    },
    "complexity": {
      "type": "string",
      "enum": ["simple", "intermediate", "complex"]
    },
    "protein_prevalence": {
      "type": "string",
      "enum": ["common", "moderate", "rare"]
    },
    "expected_answer": {
      "type": "string"
    }
  }
}
