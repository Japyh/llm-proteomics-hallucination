{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proteomics Query Schema",
  "type": "object",
  "required": ["query_id", "text", "complexity", "domain"],
  "properties": {
    "query_id": {
      "type": "string",
      "pattern": "^Q[0-9]{5}$"
    },
    "text": {
      "type": "string",
      "minLength": 10
    },
    "complexity": {
      "type": "string",
      "enum": ["simple", "intermediate", "complex"]
    },
    "domain": {
      "type": "string",
      "enum": ["oncology", "neurology", "cardiology", "immunology", "metabolism"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
